# Supabase — copy from your project settings
NEXT_PUBLIC_SUPABASE_URL=https://wqpjvppmhgsfjpxdtvip.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — copy from Settings > API (never expose this to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notion — copy from your integration token
NOTION_API_KEY=your-notion-integration-token-here

# Cron secret — make up any random string to protect the monthly sync endpoint
CRON_SECRET=change-me-to-a-random-string
